{
  "name": "deepl-mcp-server",
  "version": "1.2.2",
  "description": "MCP server for DeepL translation API",
  "main": "src/index.mjs",
  "bin": {
    "deepl-mcp-server": "./src/index.mjs"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "audit": "npm audit --omit=dev --audit-level=critical && (npm audit || echo 'Suppressing npm audit failures for dev dependencies')",
    "test": "node --check src/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepL/deepl-mcp-server.git"
  },
  "keywords": [
    "deepl",
    "mcp",
    "translation",
    "claude",
    "ai"
  ],
  "author": "DeepL SE <open-source@deepl.com> (https://www.deepl.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DeepL/deepl-mcp-server/issues"
  },
  "homepage": "https://github.com/DeepL/deepl-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "deepl-node": "1.27.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/gitlab": "13.3.3",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "prettier": "3.9.6"
  }
}
