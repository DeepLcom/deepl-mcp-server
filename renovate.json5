{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests",
  ],
  timezone: "Europe/Berlin",
  semanticCommits: "enabled",
  labels: ["renovatebot"],
  minimumReleaseAge: "3 days",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 1am on monday"],
  },
  packageRules: [
    {
      matchPackageNames: ["conventional-changelog-conventionalcommits"],
      allowedVersions: "<10",
    },
    {
      description: "One MR for the dev tooling, none of which cuts a release",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch", "pin"],
      groupName: "dev dependencies",
    },
    {
      description: "Automerge non-major updates once the pipeline passes",
      matchUpdateTypes: ["minor", "patch", "pin", "digest", "pinDigest", "lockFileMaintenance"],
      addLabels: ["automerge"],
    },
  ],
}
